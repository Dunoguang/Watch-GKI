		};
	};

	thermal-zones {

		cpu-thmzone {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			sustainable-power = <0x7d0>;
			thermal-sensors = <0xc6 0x01>;

			trips {

				trip-point@0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				trip-point@1 {
					temperature = <0x14c08>;
					hysteresis = <0x3e8>;
					type = "passive";
					linux,phandle = <0xc7>;
					phandle = <0xc7>;
				};

				cpu_crit {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0xc7>;
					contribution = <0x400>;
					cooling-device = <0xc8 0xffffffff 0xffffffff>;
				};
			};
		};

		gpu-thmzone {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			sustainable-power = <0x7d0>;
			thermal-sensors = <0xc9 0x00>;

			trips {

				trip-point@0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				trip-point@1 {
					temperature = <0x14c08>;
					hysteresis = <0x3e8>;
					type = "passive";
					linux,phandle = <0xca>;
					phandle = <0xca>;
				};

				gpu_crit {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0xca>;
					contribution = <0x400>;
					cooling-device = <0xcb 0xffffffff 0xffffffff>;
				};
			};
		};

		chg-thmzone {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0xcc 0x08>;
		};

		pa-thmzone {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0xcd 0x09>;
		};

		board-thmzone {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0xce 0x0a>;
		};
	};

	cooling-devices {

		cluster0-cooling {
			compatible = "sprd,cluster-cooling";
			#cooling-cells = <0x02>;
			sprd,efuse-block7 = <0x07>;
			sprd,efuse-block15 = <0x0f>;
			sprd,leak-core = <0x02 0x55 0x74d>;
			sprd,leak-cluster = <0x02 0x55 0x9dc>;
			sprd,core-temp-scale = <0x22 0xfffff448 0x23e38 0xffeb2428>;
			sprd,core-voltage-scale = <0xb2f 0xffffe14c 0x1d75 0xfffff698>;
			sprd,cluster-temp-scale = <0x1a 0xfffff830 0x1c138 0xfff0bdc0>;
			sprd,cluster-voltage-scale = <0x62e 0xffffef97 0xfdf 0xfffffae5>;
			sprd,efuse-switch = <0x00>;
			sprd,hotplug-period = <0x00>;
			sprd,min-cpufreq = <0xbb800>;
			sprd,min-cpunum = <0x04>;
			sprd,core-base = <0x10b>;
			sprd,cluster-base = <0x126>;
			sprd,dynamic-core = <0x352 0x300 0x384>;
			sprd,dynamic-cluster = <0x3d4 0x300 0x384>;
			linux,phandle = <0xc8>;
			phandle = <0xc8>;
		};
	};

	gpu-cooling-devices {

		gpu-cooling0 {
			compatible = "sprd,mali-power-model";
			#cooling-cells = <0x02>;
			sprd,efuse-block7 = <0x07>;
			sprd,efuse-block15 = <0x0f>;
			sprd,leak-core = <0x02 0x55 0x74d>;
			sprd,leak-cluster = <0x02 0x55 0x9dc>;
			sprd,temp-scale = <0x190 0x64 0x186a0 0x69e560>;
			sprd,voltage-scale = <0xc3 0xfffffe9a 0x157 0x5b>;
			sprd,hotplug-period = <0x00>;
			sprd,core-base = <0x2cc>;
			sprd,cluster-base = <0x00>;
			sprd,dynamic-core = <0x240e 0x300 0x41a>;
			sprd,dynamic-cluster = <0x00 0x00 0x00>;
			linux,phandle = <0xcb>;
			phandle = <0xcb>;
		};
	};

	chg-tsensor@8 {
		compatible = "sprd,board-thermal";
		#thermal-sensor-cells = <0x01>;
		io-channels = <0xb8 0x09>;
		io-channel-names = "adc_temp";
		temp-tab-size = <0x0f>;
		temp-tab-val = <0x46b 0x456 0x432 0x3d7 0x346 0x28e 0x19d 0x13c 0xee 0xb2 0x85 0x64 0x4b 0x39 0x2b>;
		temp-tab-temp = <0x25b 0x2be 0x325 0x3b8 0x44d 0x4e0 0x5a9 0x60d 0x671 0x6d5 0x739 0x79d 0x801 0x865 0x8c9>;
		status = "disabled";
		linux,phandle = <0xcc>;
		phandle = <0xcc>;
	};

	pa-tsensor@9 {
		compatible = "sprd,board-thermal";
		#thermal-sensor-cells = <0x01>;
		io-channels = <0xb8 0x05>;
		io-channel-names = "adc_temp";
		temp-tab-size = <0x0f>;
		temp-tab-val = <0x46b 0x456 0x432 0x3d7 0x346 0x28e 0x19d 0x13c 0xee 0xb2 0x85 0x64 0x4b 0x39 0x2b>;
		temp-tab-temp = <0x25b 0x2be 0x325 0x3b8 0x44d 0x4e0 0x5a9 0x60d 0x671 0x6d5 0x739 0x79d 0x801 0x865 0x8c9>;
		status = "disabled";
		linux,phandle = <0xcd>;
		phandle = <0xcd>;
	};

	bd-tsensor@10 {
		compatible = "sprd,board-thermal";
		#thermal-sensor-cells = <0x01>;
		io-channels = <0xb8 0x03>;
		io-channel-names = "adc_temp";
		temp-tab-size = <0x0f>;
		temp-tab-val = <0x46b 0x456 0x432 0x3d7 0x346 0x28e 0x19d 0x13c 0xee 0xb2 0x85 0x64 0x4b 0x39 0x2b>;
		temp-tab-temp = <0x25b 0x2be 0x325 0x3b8 0x44d 0x4e0 0x5a9 0x60d 0x671 0x6d5 0x739 0x79d 0x801 0x865 0x8c9>;
		linux,phandle = <0xce>;
		phandle = <0xce>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		mpu0-dump@877ff000 {
			reg = <0x00 0x877ff000 0x00 0x1000>;
		};

		sipc-mem@87800000 {
			reg = <0x00 0x87800000 0x00 0x3d0000>;
			linux,phandle = <0xd9>;
			phandle = <0xd9>;
		};

		wcn-mem@88000000 {
			reg = <0x00 0x88000000 0x00 0x300000>;
			linux,phandle = <0xb4>;
			phandle = <0xb4>;
		};

		gnss-mem@88300000 {
			reg = <0x00 0x88300000 0x00 0x15a800>;
			linux,phandle = <0xb7>;
			phandle = <0xb7>;
		};

		pstore@8845a800 {
			reg = <0x00 0x8845a800 0x00 0x40000>;
			linux,phandle = <0xcf>;
			phandle = <0xcf>;
		};

		cp-modem@89600000 {
			reg = <0x00 0x89600000 0x00 0x4240000>;
			sprd,cpdbg-size = <0x280000>;
			linux,phandle = <0xd8>;
			phandle = <0xd8>;
		};

		audio_dma@8d840000 {
			reg = <0x00 0x8d840000 0x00 0x80000>;
			linux,phandle = <0x9e>;
			phandle = <0x9e>;
		};

		sml-mem@94000000 {
			reg = <0x00 0x94000000 0x00 0x20000>;
		};

		tos-mem@94020000 {
			reg = <0x00 0x94020000 0x00 0x1fe0000>;
		};

		sh-mem@96000000 {
			reg = <0x00 0x96000000 0x00 0x100000>;
		};

		iq-mem@98100000 {
			compatible = "sprd,iq-mem";
			reg = <0x00 0x98100000 0x00 0x4000000>;
			linux,phandle = <0xd6>;
			phandle = <0xd6>;
		};

		camera@bdf64000 {
			reg = <0x00 0xbdf64000 0x00 0x500000>;
			linux,phandle = <0xd2>;
			phandle = <0xd2>;
		};

		fb@be464000 {
			reg = <0x00 0xbe464000 0x00 0xe10000>;
			linux,phandle = <0xd1>;
			phandle = <0xd1>;
		};

		overlaybuffer@bf274000 {
			reg = <0x00 0xbf274000 0x00 0xa8c000>;
			linux,phandle = <0xd0>;
			phandle = <0xd0>;
		};
	};

	ramoops {
		compatible = "ramoops";
		memory-region = <0xcf>;
		record-size = <0x00 0x8000>;
		console-size = <0x00 0x8000>;
		pmsg-size = <0x00 0x8000>;
	};

	ion {
		compatible = "sprd,ion";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		phys-offset = <0x80000000>;

		heap@0 {
			reg = <0x00>;
			label = "system";
			type = <0x00>;
		};

		heap@2 {
			reg = <0x02>;
			label = "carveout_overlay";
			type = <0x02>;
			memory-region = <0xd0>;
		};

		heap@3 {
			reg = <0x03>;
			label = "carveout_fb";
			type = <0x02>;
			memory-region = <0xd1>;
		};

		heap@4 {
			reg = <0x04>;
			label = "carveout_camera";
			type = <0x02>;
			memory-region = <0xd2>;
		};
	};

	sprd-adf {
		compatible = "sprd-adf";
		status = "okay";
		sprd,display-mode = <0x03>;
		sprd,dispc = <0xd3>;
	};

	sprd_backlight {
		compatible = "pwm-backlight";
		pwms = <0xd4 0x00 0x4e20>;
		pwm-names = "backlight";
		brightness_max = <0x100>;
		brightness-levels = <0x06 0x06 0x06 0x06 0x06 0x06 0x06 0x06 0x06 0x06 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10 0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22 0x23 0x24 0x25 0x26 0x27 0x28 0x29 0x2a 0x2b 0x2c 0x2d 0x2e 0x2f 0x30 0x31 0x32 0x33 0x34 0x35 0x36 0x37 0x38 0x39 0x3a 0x3b 0x3c 0x3d 0x3e 0x3f 0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47 0x48 0x49 0x4a 0x4b 0x4c 0x4d 0x4e 0x4f 0x50 0x51 0x52 0x53 0x54 0x55 0x56 0x57 0x58 0x59 0x5a 0x5b 0x5c 0x5d 0x5e 0x5f 0x60 0x61 0x62 0x63 0x64 0x65 0x66 0x67 0x68 0x69 0x6a 0x6b 0x6c 0x6d 0x6e 0x6f 0x70 0x71 0x72 0x73 0x74 0x75 0x76 0x77 0x78 0x79 0x7a 0x7b 0x7c 0x7d 0x7e 0x7f 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f 0x90 0x91 0x92 0x93 0x94 0x95 0x96 0x97 0x98 0x99 0x9a 0x9b 0x9c 0x9d 0x9e 0x9f 0xa0 0xa1 0xa2 0xa3 0xa4 0xa5 0xa6 0xa7 0xa8 0xa9 0xaa 0xab 0xac 0xad 0xae 0xaf 0xb0 0xb1 0xb2 0xb3 0xb4 0xb5 0xb6 0xb7 0xb8 0xb9 0xba 0xbb 0xbc 0xbd 0xbe 0xbf 0xc0 0xc1 0xc2 0xc3 0xc4 0xc5 0xc6 0xc7 0xc8 0xc9 0xca 0xcb 0xcc 0xcd 0xce 0xcf 0xd0 0xd1 0xd2 0xd3 0xd4 0xd5 0xd6 0xd7 0xd8 0xd9 0xda 0xdb 0xdc 0xdd 0xde 0xdf 0xe0 0xe1 0xe2 0xe3 0xe4 0xe5 0xe6 0xe7 0xe8 0xe9 0xea 0xeb 0xec 0xed 0xee 0xef 0xf0 0xf1 0xf2 0xf3 0xf4 0xf5 0xf6 0xf7 0xf8 0xf9 0xfa 0xfb>;
		default-brightness-level = <0x64>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x80000000>;
		linux,phandle = <0xd7>;
		phandle = <0xd7>;
	};

	chosen {
		stdout-path = "/soc/ap-apb/serial@70100000";
		bootargs = "earlycon=sprd_serial,0x70100000,115200n8 console=ttyS1,115200n8 loglevel=8 init=/init root=/dev/ram0 rw androidboot.hardware=sp9832e_1h10";
	};

	interrupt-controller {
		compatible = "android,CustomIPI";
		#interrupt-cells = <0x01>;
		interrupt-controller;
		linux,phandle = <0xd5>;
		phandle = <0xd5>;
	};

	trusty {
		compatible = "android,trusty-smc-v1";

		irq {
			compatible = "android,trusty-irq-v1";
			interrupt-templates = <0xd5 0x00 0x01 0x01 0x01 0x00 0x01 0x01 0x00 0x00>;
			interrupt-ranges = <0x00 0x0f 0x00 0x10 0x1f 0x01 0x20 0xdf 0x02>;
		};

		virtio {
			compatible = "android,trusty-virtio-v1";
		};

		log {
			compatible = "android,trusty-log-v1";
		};
	};

	sprd-iq {
		compatible = "sprd,iq";
		sprd,region = <0xd6>;
		sprd,mapping-offs = <0x00>;
	};

	sprd-sysdump {
		memory-region = <0xd7>;
		memory-region-re = <0xd8 0xb4 0xd9 0xb7>;
	};

	sprd_map_user {
		compatible = "sprd,sprd_map_user";
	};

	sprd-wlan {
		compatible = "sprd,sp9832e";
	};

	gpio-keys {
		compatible = "gpio-keys";
		input-name = "sprd-gpio-keys";
		status = "ok";

		key-volumndown {
			label = "Volume Down Key";
			linux,code = <0x72>;
			gpios = <0x19 0x0a 0x00>;
			debounce-interval = <0x02>;
			gpio-key,wakeup;
			gpio-key,level-trigger;
		};

		key-volumeup {
			label = "Volume Up Key";
			linux,code = <0x73>;
			gpios = <0xda 0x02 0x01>;
			debounce-interval = <0x02>;
			gpio-key,wakeup;
			gpio-key,level-trigger;
		};

		key-power {
			label = "Power Key";
			linux,code = <0x74>;
			gpios = <0x19 0x01 0x01>;
			gpio-key,wakeup;
			gpio-key,level-trigger;
		};
	};

	flash-gpios {
		compatible = "sprd,flash-gpio";
	};

	sunwave-fp {
		compatible = "sunwave,fingerprint";
		sunwave,reset-gpio = <0x10 0x83 0x00>;
		sunwave,irq-gpio = <0x29 0x0d 0x00>;
	};

	fingerprint {
		compatible = "fpsensor,fingerprint";
		fpreset-gpios = <0x10 0x83 0x00>;
		fpint-gpios = <0x29 0x0d 0x00>;
	};

	ma-fingerprint {
		compatible = "microarray,fingerprint";
		maint-gpios = <0x29 0x0d 0x00>;
	};

	fingerprint_blestech {
		compatible = "sprd,betterlife-fp";
		reset-gpio = <0x10 0x83 0x00>;
		int_gpio = <0x29 0x0d 0x00>;
	};

	scene-frequency {
		compatible = "sprd,dfs";
		sprd-scene = "lcdon\0lcdoff\0camlow\0camhigh";
		sprd-freq = <0x100 0x100 0x180 0x29b>;
	};
};
