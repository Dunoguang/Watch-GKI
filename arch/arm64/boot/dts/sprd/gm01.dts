		syscon@71700000 {
			compatible = "sprd,sys-ap-intc\0syscon";
			reg = <0x00 0x71700000 0x00 0x10000>;
			linux,phandle = <0xaa>;
			phandle = <0xaa>;
		};

		ap-apb {
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			serial@70100000 {
				compatible = "sprd,sc9836-uart";
				reg = <0x00 0x70100000 0x00 0x100>;
				interrupts = <0x00 0x03 0x04>;
				clock-names = "enable\0uart\0source";
				clocks = <0x03 0x0e 0x04 0x05>;
				status = "okay";
			};

			i2c@70500000 {
				compatible = "sprd,r8p0-i2c";
				reg = <0x00 0x70500000 0x00 0x1000>;
				interrupts = <0x00 0x0b 0x04>;
				clock-names = "enable\0i2c\0source";
				clocks = <0x03 0x08 0x06 0x05>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";

				sensor-main@20 {
					compatible = "sprd,sensor-main";
					reg = <0x20>;
					clock-names = "clk_src\0sensor_eb\0clk_96m\0clk_76m8\0clk_48m\0clk_26m";
					clocks = <0x07 0x08 0x01 0x09 0x0a 0x0b 0x05>;
					vddio-supply = <0x0c>;
					vddcama-supply = <0x0d>;
					vddcamd-supply = <0x0e>;
					vddcammot-supply = <0x0f>;
					reset-gpios = <0x10 0x2c 0x00>;
					power-down-gpios = <0x10 0x2e 0x00>;
					host = "dcam0";

					port {

						endpoint {
							remote-endpoint = <0x11>;
							linux,phandle = <0x63>;
							phandle = <0x63>;
						};
					};
				};

				sensor-main2@6C {
					compatible = "sprd,sensor-main2";
					reg = <0x6c>;
					clock-names = "clk_src\0sensor_eb\0clk_96m\0clk_76m8\0clk_48m\0clk_26m";
					clocks = <0x12 0x08 0x02 0x09 0x0a 0x0b 0x05>;
					vddio-supply = <0x0c>;
					vddcama-supply = <0x0d>;
					vddcamd-supply = <0x0e>;
					vddcammot-supply = <0x0f>;
					reset-gpios = <0x10 0x2d 0x00>;
					power-down-gpios = <0x10 0x2f 0x00>;
					host = "dcam1";

					port {

						endpoint {
							remote-endpoint = <0x13>;
							linux,phandle = <0x65>;
							phandle = <0x65>;
						};
					};
				};
			};

			i2c@70600000 {
				compatible = "sprd,r8p0-i2c";
				reg = <0x00 0x70600000 0x00 0x1000>;
				interrupts = <0x00 0x0c 0x04>;
				clock-names = "enable\0i2c\0source";
				clocks = <0x03 0x09 0x14 0x05>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";

				sensor-sub@20 {
					compatible = "sprd,sensor-sub";
					reg = <0x20>;
					clock-names = "clk_src\0sensor_eb\0clk_96m\0clk_76m8\0clk_48m\0clk_26m";
					clocks = <0x12 0x08 0x02 0x09 0x0a 0x0b 0x05>;
					vddio-supply = <0x0c>;
					vddcama-supply = <0x0d>;
					vddcamd-supply = <0x0e>;
					vddcammot-supply = <0x0f>;
					reset-gpios = <0x10 0x29 0x00>;
					power-down-gpios = <0x10 0x28 0x00>;
					host = "dcam1";

					port {

						endpoint {
							remote-endpoint = <0x15>;
							linux,phandle = <0x66>;
							phandle = <0x66>;
						};
					};
				};
			};

			i2c@70700000 {
				compatible = "sprd,r8p0-i2c";
				reg = <0x00 0x70700000 0x00 0x1000>;
				interrupts = <0x00 0x0d 0x04>;
				clock-names = "enable\0i2c\0source";
				clocks = <0x03 0x0a 0x16 0x05>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";
			};

			i2c@70800000 {
				compatible = "sprd,r8p0-i2c";
				reg = <0x00 0x70800000 0x00 0x1000>;
				interrupts = <0x00 0x0e 0x04>;
				clock-names = "enable\0i2c\0source";
				clocks = <0x03 0x0b 0x17 0x05>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";

				tlsc6x@2e {
					compatible = "tlsc6x,tlsc6x_ts";
					reg = <0x2e>;
					gpios = <0x10 0x91 0x00 0x10 0x90 0x00>;
					vdd_name = "vdd18";
					TP_MAX_X = <480>;
					TP_MAX_Y = <960>;
				};
			};

			i2c@70900000 {
				compatible = "sprd,r8p0-i2c";
				reg = <0x00 0x70900000 0x00 0x1000>;
				interrupts = <0x00 0x0f 0x04>;
				clock-names = "enable\0i2c\0source";
				clocks = <0x03 0x0c 0x18 0x05>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";

				flash-ic@63 {
					compatible = "sprd,flash-ocp8137";
					reg = <0x63>;
					sprd,flash-ic = <0x1fc9>;
					sprd,torch = <0x01>;
					sprd,preflash = <0x01>;
					sprd,highlight = <0x01>;
					sprd,torch-level = <0x80>;
					sprd,preflash-level = <0x80>;
					sprd,highlight-level = <0x80>;
					sprd,lvfm-enable = <0x01>;
					flash-torch-en-gpios = <0x10 0x58 0x00>;
					flash-chip-en-gpios = <0x10 0x59 0x00>;
					flash-en-gpios = <0x10 0x4c 0x00>;
					flash-sync-gpios = <0x10 0x8d 0x00>;
				};

				charger@6a {
					compatible = "fairchild,fan54015_chg";
					reg = <0x6a>;
					chg-fault-gpios = <0x10 0x08 0x00>;
					vbus-det-gpios = <0x19 0x00 0x00>;
				};
			};

			spi@70a00000 {
				compatible = "sprd,spi-r4p0";
				reg = <0x00 0x70a00000 0x00 0x1000>;
				interrupts = <0x00 0x07 0x04>;
				clock-names = "enable\0spi\0source";
				sprd,dma-mode = <0x00>;
				sprd,rxtx-dma = <0x0b 0x0c>;
				dma-names = "rx_chn\0tx_chn";
				dmas = <0x1a 0x0b 0x1a 0x0c>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";
				clocks = <0x03 0x05 0x1b 0x1c>;
			};

			spi@70b00000 {
				compatible = "sprd,spi-r4p0";
				reg = <0x00 0x70b00000 0x00 0x1000>;
				interrupts = <0x00 0x08 0x04>;
				clock-names = "enable\0spi\0source";
				sprd,dma-mode = <0x00>;
				sprd,rxtx-dma = <0x0d 0x0e>;
				dma-names = "rx_chn\0tx_chn";
				dmas = <0x1a 0x0d 0x1a 0x0e>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				clocks = <0x1d 0x09 0x1e 0x1c>;
			};

			spi@70c00000 {
				compatible = "sprd,spi-r4p0";
				reg = <0x00 0x70c00000 0x00 0x1000>;
				interrupts = <0x00 0x09 0x04>;
				clock-names = "enable\0spi\0source";
				sprd,dma-mode = <0x00>;
				sprd,rxtx-dma = <0x0f 0x10>;
				dma-names = "rx_chn\0tx_chn";
				dmas = <0x1a 0x0f 0x1a 0x10>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				clocks = <0x03 0x07 0x1f 0x1c>;
			};

			i2s@70d00000 {
				compatible = "sprd,i2s";
				reg = <0x00 0x70d00000 0x00 0x100000>;
				sprd,dai_name = "i2s_bt_sco0";
				sprd,hw_port = <0x00>;
				sprd,syscon-ap-apb = <0x20>;
				#sound-dai-cells = <0x00>;
				status = "okay";
				sprd,config_type = "pcm";
				sprd,slave_timeout = <0xf11>;
				sprd,_hw_port = <0x00>;
				sprd,fs = <0x1f40>;
				sprd,bus_type = <0x01>;
				sprd,rtx_mode = <0x03>;
				sprd,byte_per_chan = <0x01>;
				sprd,slave_mode = <0x00>;
				sprd,lsb = <0x00>;
				sprd,lrck = <0x00>;
				sprd,low_for_left = <0x01>;
				sprd,clk_inv = <0x00>;
				sprd,pcm_short_frame = <0x01>;
				sprd,pcm_slot = <0x01>;
				sprd,pcm_cycle = <0x01>;
				sprd,tx_watermark = <0x0c>;
				sprd,rx_watermark = <0x14>;
				linux,phandle = <0xbf>;
				phandle = <0xbf>;
			};
		};

		ap-ahb {
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			dma-controller@20100000 {
				compatible = "sprd,ap-dma-v4.0";
				reg = <0x00 0x20100000 0x00 0x4000>;
				interrupts = <0x00 0x32 0x04>;
				#dma-cells = <0x01>;
				#dma-channels = <0x1c>;
				sprd,full-type-offset = <0x00>;
				sprd,syscon-dma-glb = <0x21>;
				clock-names = "enable";
				clocks = <0x22 0x05>;
				linux,phandle = <0x1a>;
				phandle = <0x1a>;
			};

			sdio@20600000 {
				compatible = "sprd,sdhc-r10";
				reg = <0x00 0x20600000 0x00 0x1000>;
				interrupts = <0x00 0x3c 0x04>;
				status = "okay";
				clock-names = "sdio_clk\0sdio_clk_source\0sdio_ahb_enable";
				clocks = <0x23 0x24 0x22 0x0b>;
				sprd,hs400es-dly = <0x5a 0x7f 0x30 0x30>;
				sprd,hs400-dly = <0x5a 0x8c 0x30 0x30>;
				sprd,hs200-dly = <0x7f 0x8c 0x8e 0x8e>;
				sprd,ddr52-dly = <0x9f 0xb3 0x1e 0x1e>;
				vmmc-supply = <0x25>;
				voltage-ranges = <0xbb8 0xbb8>;
				bus-width = <0x08>;
				non-removable;
				cap-mmc-hw-reset;
				mmc-hs400-enhanced-strobe;
				mmc-hs400-1_8v;
				mmc-hs200-1_8v;
				mmc-ddr-1_8v;
				sprd,name = "sdio_emmc";
				sprd,sdio-adma;
				no-sdio;
				no-sd;
			};

			sdio@20300000 {
				compatible = "sprd,sdhc-r10";
				reg = <0x00 0x20300000 0x00 0x1000>;
				interrupts = <0x00 0x39 0x04>;
				status = "okay";
				clock-names = "sdio_clk\0sdio_clk_source\0sdio_ahb_enable";
				clocks = <0x26 0x24 0x22 0x08>;
				sprd,sdr104-dly = <0x7f 0x94 0xa7 0xa7>;
				sprd,sdr50-dly = <0x7f 0x4a 0x4a 0x4a>;
				vmmc-supply = <0x27>;
				vqmmc-supply = <0x28>;
				voltage-ranges = <0xbb8 0xbb8>;
				bus-width = <0x04>;
				sd-uhs-sdr50;
				sd-uhs-sdr104;
				cd-gpios = <0x29 0x09 0x00>;
				sprd,name = "sdio_sd";
				sprd,sdio-adma;
				no-sdio;
				no-mmc;
			};

			usb@20200000 {
				compatible = "sprd,usb";
				reg = <0x00 0x20200000 0x00 0x2000>;
				interrupts = <0x00 0x37 0x04>;
				interrupt-names = "mc";
				clocks = <0x22 0x04>;
				clock-names = "core_clk";
				phy-type = "usb20_sprd_phy";
				usb-phy = <0x2a>;
				phy-names = "usb";
				dr-mode = "peripheral";
				sprd,cable-detection-method = "typec";
				sprd,vbus-gpios = <0x19 0x00 0x00>;
			};

			iommu@20800160 {
				compatible = "sprd,iommuexle-dispc";
				reg = <0x00 0x20800160 0x00 0x04 0x00 0x20800800 0x00 0x60 0x00 0x70000000 0x00 0x8000000>;
				reg_name = "mmu_interrupt_reg\0mmu_reg\0iova pool";
				status = "okay";
				#iommu-cells = <0x00>;
				linux,phandle = <0x34>;
				phandle = <0x34>;
			};

			iommu@20a00800 {
				compatible = "sprd,iommuexle-gsp";
				reg = <0x00 0x20a00800 0x00 0x04 0x00 0x20a00804 0x00 0x60 0x00 0x20000000 0x00 0x10000000>;
				reg_name = "mmu_interrupt_reg\0mmu_reg\0iova pool";
				status = "okay";
