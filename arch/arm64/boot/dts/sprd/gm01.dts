			gsp@20a00000 {
				compatible = "sprd,gsp-core";
				reg = <0x00 0x20a00000 0x00 0x1000>;
				core-id = <0x00>;
				kcfg-num = <0x08>;
				interrupts = <0x00 0x33 0x04>;
				iommus = <0x2b>;
				sprd,sys-ap-ahb = <0x21>;
				clock-names = "clk_gsp\0clk_gsp_parent\0clk_gsp_eb";
				clocks = <0x2c 0x2d 0x22 0x03>;
				linux,phandle = <0xa6>;
				phandle = <0xa6>;
