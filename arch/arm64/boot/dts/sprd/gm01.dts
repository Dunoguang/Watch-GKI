/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	cpuinfo_hardware = "Spreadtrum SC9832e";
	model = "Spreadtrum SC9832e Board";
	compatible = "sprd,sp9832e-1h10\0sprd,sc9832e";
	sprd,sc-id = <0x2668 0x01 0x20000>;

	aliases {
		serial1 = "/soc/ap-apb/serial@70100000";
		i2c0 = "/soc/ap-apb/i2c@70500000";
		i2c1 = "/soc/ap-apb/i2c@70600000";
		i2c2 = "/soc/ap-apb/i2c@70700000";
		i2c3 = "/soc/ap-apb/i2c@70800000";
		i2c4 = "/soc/ap-apb/i2c@70900000";
		spi0 = "/soc/ap-apb/spi@70a00000";
		spi1 = "/soc/ap-apb/spi@70b00000";
		spi2 = "/soc/ap-apb/spi@70c00000";
		hwspinlock1 = "/soc/aon/hwspinlock@33000000";
		thm-sensor0 = "/soc/aon/gpu-thm@402f0000";
		thm-sensor1 = "/soc/aon/cpu-thm@40300000";
		thm-sensor8 = "/chg-tsensor@8";
		thm-sensor9 = "/pa-tsensor@9";
		thm-sensor10 = "/bd-tsensor@10";
		thm-sensor11 = "/thermal-zones/cpu-thmzone";
		cooling-device0 = "/cooling-devices/cluster0-cooling";
		gpu-cooling0 = "/gpu-cooling-devices/gpu-cooling0";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		syscon@20e00000 {
			compatible = "sprd,sys-ap-ahb\0syscon";
			reg = <0x00 0x20e00000 0x00 0x10000>;
			hwlocks = <0x02 0x01>;
			hwlock-names = "syscon";
			linux,phandle = <0x21>;
			phandle = <0x21>;
		};

		syscon@300e0000 {
			compatible = "sprd,sys-pub-apb\0syscon";
			reg = <0x00 0x300e0000 0x00 0x10000>;
			linux,phandle = <0xb2>;
			phandle = <0xb2>;
		};

		syscon@40200000 {
			compatible = "sprd,sys-aon-intc\0syscon";
			reg = <0x00 0x40200000 0x00 0x10000>;
			linux,phandle = <0xab>;
			phandle = <0xab>;
		};

		syscon@402b0000 {
			compatible = "sprd,sys-pmu-apb\0syscon";
			reg = <0x00 0x402b0000 0x00 0x10000>;
			#syscon-cells = <0x02>;
