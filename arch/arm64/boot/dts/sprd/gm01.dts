			compatible = "sprd,sys-ap-intc\0syscon";
			reg = <0x00 0x71400000 0x00 0x10000>;
			linux,phandle = <0xa7>;
			phandle = <0xa7>;
		};

		syscon@71500000 {
			compatible = "sprd,sys-ap-intc\0syscon";
			reg = <0x00 0x71500000 0x00 0x10000>;
			linux,phandle = <0xa8>;
			phandle = <0xa8>;
		};

		syscon@71600000 {
			compatible = "sprd,sys-ap-intc\0syscon";
			reg = <0x00 0x71600000 0x00 0x10000>;
			linux,phandle = <0xa9>;
